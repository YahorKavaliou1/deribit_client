# PostgreSQL (shared by the postgres container and the application)
POSTGRES_USER=deribit
POSTGRES_PASSWORD=deribit
POSTGRES_DB=deribit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RabbitMQ (shared by the rabbitmq container and the Celery broker URL)
RABBITMQ_DEFAULT_USER=deribit
RABBITMQ_DEFAULT_PASS=deribit

# Celery
CELERY_BROKER_URL=amqp://deribit:deribit@localhost:5672//
CELERY_PRICE_FETCH_INTERVAL_SECONDS=60

# Deribit
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_REQUEST_TIMEOUT_SECONDS=10
